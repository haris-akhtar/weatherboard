# Copy to .env.local and fill in. Never commit real keys.
#
# NOTE: every VITE_ variable is inlined into the JavaScript bundle and is
# visible to anyone who opens the site. These are free-tier, rate-limited keys;
# restrict them in each provider's dashboard where possible. They are not secret.

# https://home.openweathermap.org/api_keys  (free "Current Weather" + "5 day / 3 hour forecast")
VITE_OPENWEATHER_API_KEY=

# https://rapidapi.com/wirefreethought/api/geodb-cities  (free Basic plan)
VITE_RAPIDAPI_KEY=
VITE_RAPIDAPI_HOST=wft-geo-db.p.rapidapi.com
